# ==============================================================================
# QUIZ VNUA - BIẾN MÔI TRƯỜNG MẪU GIAO DIỆN CLIENT (client/.env.example)
# ==============================================================================

# --- 1. ĐỊA CHỈ REST API BACKEND ---
VITE_API_URL=http://localhost:8080/api/v1/

# --- 2. ĐƯỜNG DẪN ẢNH ĐẠI DIỆN TĨNH / CDN ---
VITE_AVATAR_URL=

# --- 3. MÃ ĐỊNH DANH GOOGLE OAUTH2 CLIENT ID ---
VITE_GOOGLE_CLIENT_ID=change-me
