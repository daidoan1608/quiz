# ==============================================================================
# QUIZ CHATOPS - MẪU BIẾN MÔI TRƯỜNG CẤU HÌNH (.env.example)
# ==============================================================================

# --- 1. SLACK TOKENS (BẮT BUỘC) ---
# Lấy từ Slack App Dashboard (Socket Mode App Token: xapp-..., Bot User Token: xoxb-...)
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...

# --- 2. PROMETHEUS INTERNAL ENDPOINT ---
# URL nội bộ để ChatOps gửi request lấy alerts (Local: http://localhost:9090, Docker: http://prometheus:9090)
PROMETHEUS_URL=http://localhost:9090

# --- 3. PUBLIC URLS (TÙY CHỌN DÀNH CHO BUTTON MỞ BROWSER TỪ SLACK) ---
# Trên Production: Cấu hình domain công khai (vd: https://monitor.example.com, https://prometheus.example.com)
# Trên Local: Mặc định tự động nhận diện theo GRAFANA_PORT (3002) và PROMETHEUS_PORT (9090)
GRAFANA_PUBLIC_URL=http://localhost:3002
PROMETHEUS_PUBLIC_URL=http://localhost:9090

# --- 4. DOCKER ENGINE SOCKET ---
# Linux / Docker Container: /var/run/docker.sock
# Windows Local Dev: //./pipe/docker_engine
DOCKER_SOCKET_PATH=/var/run/docker.sock

# --- 5. TIỀN TỐ DỰ ÁN DOCKER (CONTAINER PREFIX) ---
# Mặc định là tên project trong docker-compose: quiz
CONTAINER_PREFIX=quiz
