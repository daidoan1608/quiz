# Slack App & Bot Tokens (Lấy từ Slack App Dashboard -> Socket Mode & OAuth)
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...

# URL truy vấn Prometheus Alerts (Khi chạy local: http://localhost:9090, khi chạy trong Docker: http://prometheus:9090)
PROMETHEUS_URL=http://localhost:9090

# Đường dẫn Docker Engine Socket (Linux/Docker: /var/run/docker.sock, Windows: //./pipe/docker_engine)
DOCKER_SOCKET_PATH=/var/run/docker.sock
