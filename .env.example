# Runtime profile
SPRING_PROFILES_ACTIVE=dev
SPRING_APPLICATION_NAME=quiz
SERVER_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=quiz
DB_USER=root
DB_PASSWORD=change-this-database-password
# Optional full JDBC override. Use this for prod/test if needed.
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/quiz
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver

# Upload local fallback
AVATAR_UPLOAD_DIR=uploads/avatars
QUESTION_UPLOAD_DIR=uploads/questions
AVATAR_DEFAULT_URL=/avatars/default.png

# Google OAuth
GOOGLE_CLIENT_ID=change-me-in-env

# Multipart
MULTIPART_MAX_FILE_SIZE=5MB
MULTIPART_MAX_REQUEST_SIZE=5MB

# JPA
JPA_SHOW_SQL=true
JPA_DDL_AUTO=update

# JWT
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=example@gmail.com
MAIL_PASSWORD=change-me-in-env
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# Swagger
SWAGGER_API_DOCS_ENABLED=true
SWAGGER_UI_ENABLED=true
SWAGGER_UI_PATH=/swagger-ui
SWAGGER_API_DOCS_PATH=/v3/api-docs

# App web config
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
APP_COOKIE_DOMAIN=
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Strict
APP_COOKIE_MAX_AGE=86400

# Admin initializer - disabled by default. Enable only for first setup.
ADMIN_INITIALIZER_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Quản trị viên Hệ thống

# Security
APP_SECURITY_CSRF_ENABLED=true
