SPRING_APPLICATION_NAME=quiz
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=3306
DB_NAME=quiz
DB_USER=root
DB_PASSWORD=root
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
SPRING_CACHE_TYPE=none
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=quiz
JPA_SHOW_SQL=true
JPA_DDL_AUTO=update
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=0

JWT_SECRET=replace-with-at-least-32-bytes-random-secret
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=example@gmail.com
MAIL_PASSWORD=change-me
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

APP_FRONTEND_BASE_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://admin.localhost,http://api.localhost,http://localhost:3000,http://localhost:3001
APP_COOKIE_DOMAIN=
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Strict
APP_COOKIE_MAX_AGE=86400
APP_SECURITY_CSRF_ENABLED=false

GOOGLE_CLIENT_ID=change-me
REACT_APP_GOOGLE_CLIENT_ID=change-me

ADMIN_INITIALIZER_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=System Administrator

CLIENT_API_URL=/api/v1/
CLIENT_AVATAR_URL=
ADMIN_API_URL=/api/v1/
ADMIN_BASENAME=/
