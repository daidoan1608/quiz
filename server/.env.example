# Copy this file to either:
# - server/.env.local for local development
# - server/.env.production for production/Docker production
#
# Keep real values out of git.

SPRING_APPLICATION_NAME=quiz
SERVER_PORT=8080
JAVA_TOOL_OPTIONS="-Xms256m -Xmx768m -XX:+UseG1GC"

DB_HOST=localhost
DB_PORT=3306
DB_NAME=quiz
DB_USER=root
DB_PASSWORD=change-me
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
SPRING_CACHE_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=quiz
JPA_SHOW_SQL=true
JPA_DDL_AUTO=update
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=0

JWT_SECRET=replace-with-at-least-32-bytes-random-secret
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=example@gmail.com
MAIL_PASSWORD=change-me
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

GOOGLE_CLIENT_ID=change-me
REACT_APP_GOOGLE_CLIENT_ID=change-me
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=quiz
IMGBB_ENABLED=false
IMGBB_API_KEY=
IMAGE_STORAGE_PRIMARY=cloudinary

APP_FRONTEND_BASE_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://admin.localhost,http://api.localhost,http://localhost:3000,http://localhost:3001
APP_COOKIE_DOMAIN=
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Strict
APP_COOKIE_MAX_AGE=86400
APP_SECURITY_CSRF_ENABLED=false

SWAGGER_API_DOCS_ENABLED=true
SWAGGER_UI_ENABLED=true
SWAGGER_UI_PATH=/swagger-ui
SWAGGER_API_DOCS_PATH=/v3/api-docs

# System Ports Configuration (Cac cong dau noi he thong)
CLIENT_PORT=3000
ADMIN_PORT=3001
RABBITMQ_MANAGEMENT_PORT=15672
NGINX_PORT=80
NGINX_HTTPS_PORT=443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
REDIS_EXPORTER_PORT=9121


ADMIN_INITIALIZER_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=System Administrator

CLIENT_API_URL=/api/v1/
CLIENT_AVATAR_URL=
ADMIN_BASENAME=/

# AI Configuration (Gemini or OpenAI / DeepSeek / Ollama)
AI_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Monitoring (Grafana Branding & Admin)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_APP_TITLE=Quiz VNUA - Giám Sát Hệ Thống
GRAFANA_APP_SUB_TITLE=Hệ thống giám sát và cảnh báo sự cố Quiz VNUA
GRAFANA_ORG_NAME=Quiz VNUA
GRAFANA_INSTANCE_NAME=Quiz VNUA Monitor

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
