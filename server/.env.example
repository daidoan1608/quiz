# ==============================================================================
# QUIZ VNUA - MẪU BIẾN MÔI TRƯỜNG BACKEND LOCAL (server/.env.example)
# ==============================================================================
# Hướng dẫn: Sao chép tệp này thành server/.env hoặc server/.env.local để chạy backend thủ công.
# Tuyệt đối không commit các mật khẩu thực tế hoặc API keys bí mật lên Git.
# ==============================================================================

# ==============================================================================
# 1. ỨNG DỤNG & MÁY CHỦ SPRING BOOT (APPLICATION & JVM CONFIG)
# ==============================================================================
SPRING_APPLICATION_NAME=quiz
SERVER_PORT=8080
JAVA_TOOL_OPTIONS="-Xms256m -Xmx768m -XX:+UseG1GC"

# ==============================================================================
# 2. CƠ SỞ DỮ LIỆU MYSQL (DATABASE CONFIGURATION - DOCKER COMPOSE)
# ==============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=quiz
DB_USER=root
DB_PASSWORD=change-me
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/quiz?useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_unicode_ci&serverTimezone=Asia/Ho_Chi_Minh

# Tham số cấu hình MySQL Container
MYSQL_DATABASE=quiz
MYSQL_ROOT_PASSWORD=change-me
MYSQL_INNODB_BUFFER_POOL_SIZE=256M
MYSQL_MAX_CONNECTIONS=100

# ==============================================================================
# 3. BỘ ĐỆM & QUẢN LÝ PHIÊN REDIS (REDIS CACHE & SESSION)
# ==============================================================================
SPRING_CACHE_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_TIMEOUT=2s
REDIS_REPOSITORIES_ENABLED=false
REDIS_KEY_PREFIX=quiz
REDIS_ADDR=redis://localhost:6379

# ==============================================================================
# 4. CẤU HÌNH ORM & MIGRATION (JPA, HIBERNATE & FLYWAY)
# ==============================================================================
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=0
SPRING_FLYWAY_ENABLED=false
JPA_SHOW_SQL=true
JPA_DDL_AUTO=update

# ==============================================================================
# 5. LƯU TRỮ TỆP TIN NỘI BỘ (LOCAL FILE UPLOAD PATHS & LIMITS)
# ==============================================================================
AVATAR_UPLOAD_DIR=uploads/avatars
QUESTION_UPLOAD_DIR=uploads/questions
DOCUMENT_UPLOAD_DIR=uploads/documents
AVATAR_DEFAULT_URL=/avatars/default.png
MULTIPART_MAX_FILE_SIZE=25MB
MULTIPART_MAX_REQUEST_SIZE=25MB

# ==============================================================================
# 6. BẢO MẬT XÁC THỰC & PHIÊN JWT (JWT SECURITY & COOKIE)
# ==============================================================================
JWT_SECRET=replace-with-at-least-32-bytes-random-secret
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ==============================================================================
# 7. MÁY CHỦ GỬI EMAIL THÔNG BÁO & OTP (SMTP MAIL CONFIGURATION)
# ==============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=example@gmail.com
MAIL_PASSWORD=change-me
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
EMAIL_VERIFICATION_EXPIRATION_MINUTES=30

# ==============================================================================
# 8. MẠNG, ĐỊNH TUYẾN DOMAIN, CORS & COOKIES (APP NETWORKING)
# ==============================================================================
APP_FRONTEND_BASE_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_COOKIE_DOMAIN=
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Strict
APP_COOKIE_MAX_AGE=86400
APP_COOKIE_REFRESH_PATH=/api/v1/auth
APP_SECURITY_CSRF_ENABLED=false

# ==============================================================================
# 9. TÀI LIỆU HÓA API (SWAGGER / OPENAPI 3)
# ==============================================================================
SWAGGER_API_DOCS_ENABLED=true
SWAGGER_UI_ENABLED=true
SWAGGER_UI_PATH=/swagger-ui
SWAGGER_API_DOCS_PATH=/v3/api-docs

# ==============================================================================
# 10. CỔNG KẾT NỐI HẠ TẦNG DOCKER & NGINX (SYSTEM PORTS CONFIGURATION)
# ==============================================================================
CLIENT_PORT=3000
ADMIN_PORT=3001
RABBITMQ_MANAGEMENT_PORT=15672
NGINX_PORT=80
NGINX_HTTPS_PORT=443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
REDIS_EXPORTER_PORT=9121

# Docker Image Tags (Môi trường registry / production)
BACKEND_IMAGE=ghcr.io/daidoan1608/quiz-backend:production
CLIENT_IMAGE=ghcr.io/daidoan1608/quiz-client:production
ADMIN_IMAGE=ghcr.io/daidoan1608/quiz-admin:production

# ==============================================================================
# 11. XÁC THỰC GOOGLE OAUTH2 / SINGLE SIGN-ON (GOOGLE IDENTITY)
# ==============================================================================
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_IDS=change-me
REACT_APP_GOOGLE_CLIENT_ID=change-me
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# ==============================================================================
# 12. DỊCH VỤ LƯU TRỮ ĐÁM MÂY (CLOUDINARY & IMGBB STORAGE)
# ==============================================================================
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=quiz
IMGBB_ENABLED=false
IMGBB_API_KEY=
IMAGE_STORAGE_PRIMARY=cloudinary

# ==============================================================================
# 13. KHỞI TẠO TÀI KHOẢN QUẢN TRỊ VIÊN MẶC ĐỊNH (DEFAULT ROOT ADMIN)
# ==============================================================================
ADMIN_INITIALIZER_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=System Administrator

# ==============================================================================
# 14. ĐỊNH TUYẾN URL CHO GIAO DIỆN FRONTEND (CLIENT & ADMIN ROUTING)
# ==============================================================================
CLIENT_API_URL=/api/v1/
CLIENT_AVATAR_URL=
ADMIN_API_URL=/api/v1/
ADMIN_BASENAME=/

# Biến môi trường Vite trực tiếp (Client & Admin tự động nạp qua envDir)
VITE_API_URL=http://localhost:8080/api/v1/
VITE_AVATAR_URL=
VITE_GOOGLE_CLIENT_ID=change-me
VITE_ADMIN_BASENAME=/

# ==============================================================================
# 15. TRỢ LÝ HỌC TẬP THÔNG MINH AI (GOOGLE GEMINI / OPENAI LLM)
# ==============================================================================
AI_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ==============================================================================
# 16. HỆ THỐNG GIÁM SÁT OBSERVABILITY (GRAFANA DASHBOARD & ADMIN)
# ==============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_APP_TITLE=Quiz VNUA - Giám Sát Hệ Thống
GRAFANA_APP_SUB_TITLE=Hệ thống giám sát và cảnh báo sự cố Quiz VNUA
GRAFANA_ORG_NAME=Quiz VNUA
GRAFANA_INSTANCE_NAME=Quiz VNUA Monitor
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#quiz-webapp

# Biến môi trường trực tiếp cho Grafana Container
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
GF_USERS_ALLOW_SIGN_UP=false
GF_USERS_AUTO_ASSIGN_ORG=true
GF_USERS_AUTO_ASSIGN_ORG_NAME=Quiz VNUA
GF_BRANDING_APP_TITLE=Quiz VNUA - Giám Sát Hệ Thống
GF_BRANDING_APP_SUB_TITLE=Hệ thống giám sát và cảnh báo sự cố Quiz VNUA
GF_SERVER_INSTANCE_NAME=Quiz VNUA Monitor

# ==============================================================================
# 17. HÀNG ĐỢI XỬ LÝ BẤT ĐỒNG BỘ (RABBITMQ MESSAGE BROKER)
# ==============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=change-me
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_LISTENER_CONCURRENCY=2
RABBITMQ_LISTENER_MAX_CONCURRENCY=5
RABBITMQ_LISTENER_PREFETCH=1
RABBITMQ_LISTENER_ACK_MODE=auto
