SPRING_APPLICATION_NAME=quiz
SERVER_PORT=8080

DB_HOST=db
DB_PORT=3306
DB_NAME=quiz
DB_USER=root
DB_PASSWORD=change-me
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/quiz?useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_unicode_ci&serverTimezone=Asia/Ho_Chi_Minh
SPRING_CACHE_TYPE=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2s
REDIS_REPOSITORIES_ENABLED=false
REDIS_KEY_PREFIX=quiz
JPA_SHOW_SQL=false
JPA_DDL_AUTO=validate
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=0

AVATAR_UPLOAD_DIR=uploads/avatars
QUESTION_UPLOAD_DIR=uploads/questions
DOCUMENT_UPLOAD_DIR=uploads/documents
AVATAR_DEFAULT_URL=/avatars/default.png

MULTIPART_MAX_FILE_SIZE=25MB
MULTIPART_MAX_REQUEST_SIZE=25MB

JWT_SECRET=replace-with-at-least-32-bytes-random-secret
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=example@gmail.com
MAIL_PASSWORD=change-me
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

APP_FRONTEND_BASE_URL=https://quizvnua.com
APP_CORS_ALLOWED_ORIGINS=https://quizvnua.com,https://www.quizvnua.com,https://admin.quizvnua.com
APP_COOKIE_DOMAIN=.quizvnua.com
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=None
APP_COOKIE_MAX_AGE=86400
EMAIL_VERIFICATION_EXPIRATION_MINUTES=30
APP_SECURITY_CSRF_ENABLED=true

SWAGGER_API_DOCS_ENABLED=true
SWAGGER_UI_ENABLED=true
SWAGGER_UI_PATH=/swagger-ui
SWAGGER_API_DOCS_PATH=/v3/api-docs

GOOGLE_CLIENT_ID=change-me
REACT_APP_GOOGLE_CLIENT_ID=change-me
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=quiz
IMGBB_ENABLED=false
IMGBB_API_KEY=
IMAGE_STORAGE_PRIMARY=cloudinary

ADMIN_INITIALIZER_ENABLED=false
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_FULL_NAME=System Administrator

CLIENT_API_URL=https://api.quizvnua.com/api/v1/
CLIENT_AVATAR_URL=https://api.quizvnua.com
ADMIN_API_URL=https://api.quizvnua.com/api/v1/
ADMIN_BASENAME=/
