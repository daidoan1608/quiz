SPRING_APPLICATION_NAME=quiz
SERVER_PORT=8080

DB_HOST=db
DB_PORT=3306
DB_NAME=quiz
DB_USER=root
DB_PASSWORD=change-me
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
JPA_SHOW_SQL=false
JPA_DDL_AUTO=validate
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=0

JWT_SECRET=replace-with-at-least-32-bytes-random-secret
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=example@gmail.com
MAIL_PASSWORD=change-me
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

APP_FRONTEND_BASE_URL=https://quizvnua.com
APP_CORS_ALLOWED_ORIGINS=https://quizvnua.com,https://www.quizvnua.com,https://admin.quizvnua.com
APP_COOKIE_DOMAIN=.quizvnua.com
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=None
APP_COOKIE_MAX_AGE=86400
APP_SECURITY_CSRF_ENABLED=true

GOOGLE_CLIENT_ID=change-me
REACT_APP_GOOGLE_CLIENT_ID=change-me

ADMIN_INITIALIZER_ENABLED=false
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_FULL_NAME=System Administrator

CLIENT_API_URL=https://api.quizvnua.com/api/v1/
CLIENT_AVATAR_URL=https://api.quizvnua.com
ADMIN_API_URL=https://api.quizvnua.com/api/v1/
ADMIN_BASENAME=/
